# ── Airtable (server-side only — NEVER expose these in frontend code) ─────────
# Your Airtable base ID (starts with "app")
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
# Your Airtable table ID (starts with "tbl") or table name
AIRTABLE_TABLE_ID="tblXXXXXXXXXXXXXX"
# Airtable Personal Access Token (starts with "pat")
AIRTABLE_PAT="patXXXXXXXXXXXXXX.XXXXXXXXXX"

# ── App config ────────────────────────────────────────────────────────────────
# Written to the "Source" field in every Airtable submission
APP_SOURCE="business-pressure-test"

# ── Frontend URLs (VITE_ prefix exposes them to the browser bundle) ───────────
VITE_CALENDLY_URL="https://calendly.com/your-link"
VITE_GUMROAD_URL="https://your-product.gumroad.com/l/your-slug"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Optional: Telegram alerts for hot leads (local dev / non-Vercel) ──────────
TELEGRAM_ALERT_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
